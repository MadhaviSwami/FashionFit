# Copy this file to ".env" (same folder) and edit the values.

# ---------------------------------------------------------------
# Virtual try-on provider
#   none        -> AI try-on disabled (the app explains this in the UI)
#   huggingface -> IDM-VTON on the free public Hugging Face Space
#                  (upper-body garments only, shared GPU quota)
#   replicate   -> IDM-VTON on Replicate (paid; tops, bottoms and dresses)
# ---------------------------------------------------------------
TRYON_PROVIDER=huggingface

# Hugging Face (optional token raises the free GPU quota)
# Create one at https://huggingface.co/settings/tokens  (read access is enough)
HF_SPACE=yisol/IDM-VTON
HF_TOKEN=

# Replicate (required when TRYON_PROVIDER=replicate)
# Create one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_MODEL=cuuupid/idm-vton
# Optional: pin a specific model version (otherwise the latest is used)
REPLICATE_MODEL_VERSION=

# Generation settings
TRYON_STEPS=30
TRYON_SEED=42
TRYON_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------
# App settings
# ---------------------------------------------------------------
# Leave empty to auto-generate one (saved in backend/.secret_key)
SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:5180
MAX_UPLOAD_MB=10
# Use the Windows certificate store for HTTPS (fixes SSL errors on some networks)
USE_SYSTEM_CERTS=true
